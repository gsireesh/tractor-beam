  },
  {
    "str": "and are therefore able to make assumptions about those contexts to",
    "box": {
      "pageNumber": 1,
      "left": 0.08790522875816993,
      "top": 0.7019136363636365,
      "width": 0.39256100580392167,
      "height": 0.01132121212121212
    }
  },
  {
