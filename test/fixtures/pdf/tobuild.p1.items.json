  },
  {
    "str": "NLP is in a period of disruptive change that is",
    "box": {
      "pageNumber": 1,
      "left": 0.14760446196386215,
      "top": 0.28250270705789693,
      "width": 0.3095423569526895,
      "height": 0.011834204007243181
    }
  },
  {
    "str": "impacting our methodologies, funding sources,",
    "box": {
