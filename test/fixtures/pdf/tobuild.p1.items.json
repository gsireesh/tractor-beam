      "top": 0.2967036093230278,
      "width": 0.31162272500274146,
      "height": 0.011834204007243181
    }
  },
  {
    "str": "and public perception. In this work, we seek to",
    "box": {
      "pageNumber": 1,
      "left": 0.14760446196386215,
      "top": 0.3109045115881585,
      "width": 0.3095376371358771,
      "height": 0.011834204007243181
    }
  },
  {
