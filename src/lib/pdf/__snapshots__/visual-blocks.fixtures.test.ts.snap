exports[`groupItemsIntoBlocks on real PDF fixtures > block structure snapshot: nas_whitepaper.p7.items.json 1`] = `
[
  {
    "blockId": "p1_b0",
    "text": "Effective, Efficient, and Informed Research, Development, and Demonstration for the Electricity System: Issue Paper",
  },
  {
    "blockId": "p1_b1",
    "text": "EFFECTIVE, EFFICIENT, AND INFORMED RESEARCH, DEVELOPMENT,",
  },
  {
    "blockId": "p1_b2",
    "text": "AND DEMONSTRATION FOR THE ELECTRICITY SYSTEM",
  },
  {
    "blockId": "p1_b3",
    "text": "Summary",
  },
  {
    "blockId": "p1_b4",
    "text": "The electricity system is undergoing a period of immense change in its technologies and operation. The U.S.",
  },
  {
    "blockId": "p1_b5",
    "text": "Department of Energy’s (DOE’s) Office of Electricity requested an Issue Paper from the National Academies of",
  },
  {
    "blockId": "p1_b6",
    "text": "Sciences, Engineering, and Medicine that elevates and synthesizes insights for creating effective and efficient",
  },
  {
    "blockId": "p1_b7",
    "text": "research, development, and demonstration (RD&D) in the electricity system. The authors present promising",
  },
  {
    "blockId": "p1_b8",
    "text": "specific areas for innovation and the structural elements needed to enhance the effectiveness and efficiency",
  },
  {
    "blockId": "p1_b9",
    "text": "of the electricity RD&D system. The discussion of these elements is structured into four categories: the locus",
  },
  {
    "blockId": "p1_b10",
    "text": "of electricity innovation and which actors are producing these advances, the connectivity and integration",
  },
  {
    "blockId": "p1_b11",
    "text": "of the innovation system and how to overcome its gaps, opportunities for partnerships and collaborations,",
  },
  {
    "blockId": "p1_b12",
    "text": "and how to attain leverage for creating the largest innovation impacts with a set amount of resources. The",
  },
  {
    "blockId": "p1_b13",
    "text": "U.S. electricity system is at a pivotal point in its evolution. DOE can engage with its innovation partners in",
  },
  {
    "blockId": "p1_b14",
    "text": "different ways throughout the technology life cycle to create an electricity system that is future-ready and",
  },
  {
    "blockId": "p1_b15",
    "text": "serves the public interest.",
  },
  {
    "blockId": "p1_b16",
    "text": "Introduction",
  },
  {
    "blockId": "p1_b17",
    "text": "RD&D efforts are essential underpinnings for the electricity system’s ability to support the livelihoods of its",
  },
  {
    "blockId": "p1_b18",
    "text": "users and enable the growth and strength of the U.S. economy. RD&D endeavors produce new technologies,",
  },
  {
    "blockId": "p1_b19",
    "text": "services, and operational capabilities that enter into use throughout the system with the rate of diffusion",
  },
  {
    "blockId": "p1_b20",
    "text": "affecting how quickly the electric sector can change.",
  },
  {
    "blockId": "p1_b21",
    "text": "Often, the RD&D process is characterized as being top-down (driven by organizational leadership) or bottom-",
  },
  {
    "blockId": "p1_b22",
    "text": "up (coming from researchers and employees). There is an increasing recognition over the past two decades",
  },
  {
    "blockId": "p1_b23",
    "text": "that the top-down and bottom-up processes are intertwined (Li 2023; Owen 2009). In this Issue Paper",
  },
  {
    "blockId": "p1_b24",
    "text": "the authors recognize the role and value of both. Top-down processes set the architectural and directional",
  },
  {
    "blockId": "p1_b25",
    "text": "dimensions of the ecosystem and bottom-up processes leverage diverse capital, knowledge, and resource",
  },
  {
    "blockId": "p1_b26",
    "text": "bases that give shape and context to top-down RD&D aspirations.",
  },
  {
    "blockId": "p1_b27",
    "text": "Supporting an efficient and effective innovation ecosystem for electric power will be important for unlocking",
  },
  {
    "blockId": "p1_b28",
    "text": "the capabilities to address the challenges and opportunities facing this system. At the time of writing, these",
  },
  {
    "blockId": "p1_b29",
    "text": "include strains on system reliability (DOE 2025a; NERC 2025), challenges to grid resilience (Costello 2019;",
  },
  {
    "blockId": "p1_b30",
    "text": "Gibson 2020; NASEM 2017), accelerating demand growth (ACP 2025; ICF 2025), concerns over electricity",
  },
  {
    "blockId": "p1_b31",
    "text": "prices (McGee and Tyndall 2025; Wiser et al. 2025), regulatory paradigms that may unnecessarily constrain",
  },
  {
    "blockId": "p1_b32",
    "text": "innovation (Kiesling et al. 2025; Schwartz 2022), and increasingly complex supply chain considerations",
  },
  {
    "blockId": "p1_b33",
    "text": "(Howard 2025). The U.S. federal government has a strong history of supporting RD&D endeavors for",
  },
  {
    "blockId": "p1_b34",
    "text": "critical technologies and systems, with DOE’s efforts specifically enabling improvements in reliability and",
  },
  {
    "blockId": "p1_b35",
    "text": "affordability for the U.S. energy systems (Urecki and Das 2025). These outcomes result not just from DOE’s",
  },
  {
    "blockId": "p1_b36",
    "text": "direct research work but also from its engagement of a broad network of innovation partners including",
  },
  {
    "blockId": "p1_b37",
    "text": "national laboratories, universities, and the private sector (NASEM 2021a).",
  },
  {
    "blockId": "p1_b38",
    "text": "1",
  },
  {
    "blockId": "p1_b39",
    "text": "Copyright National Academy of Sciences. All rights reserved.",
  },
]
`;

exports[`groupItemsIntoBlocks on real PDF fixtures > block structure snapshot: sciencedirect.p1.items.json 1`] = `
[
  {
    "blockId": "p1_b0",
    "text": "Journal of the European Ceramic Society 40 (2020) 4774–4782",
  },
  {
    "blockId": "p1_b1",
    "text": "Contents lists available at ScienceDirect",
  },
  {
    "blockId": "p1_b2",
    "text": "Journal of the European Ceramic Society",
  },
  {
    "blockId": "p1_b3",
    "text": "journal homepage: www.elsevier.com/locate/jeurceramsoc",
  },
  {
    "blockId": "p1_b4",
    "text": "Small scale fracture and strength of high-entropy carbide grains during microcantilever bending experiments",
  },
  {
    "blockId": "p1_b5",
    "text": "T",
  },
  {
    "blockId": "p1_b6",
    "text": "a, a b c a,d Tamás Csanádi *, Marek Vojtko , Zoltán Dankházi , Michael J. Reece , Ján Dusza",
  },
  {
    "blockId": "p1_b7",
    "text": "a Institute of Materials Research, Slovak Academy of Sciences, Watsonova 47, 04353 Košice, Slovak Republic b Department of Materials Physics, Eötvös Loránd University, Pázmány P. sétány 1/A, 1117 Budapest, Hungary c School of Engineering and Material Science, Queen Mary University of London, Mile End Road, London, E1 4NS, UK d Donát Bánki Faculty of Mechanical and Safety Engineering, Óbuda University, Népszínház utca 8, 1081 Budapest, Hungary",
  },
  {
    "blockId": "p1_b8",
    "text": "A R T I C L E I N F O",
  },
  {
    "blockId": "p1_b9",
    "text": "A B S T R A C T",
  },
  {
    "blockId": "p1_b10",
    "text": "Keywords: Fracture strength fracture surface microcantilever bending high-entropy carbide fracture toughness",
  },
  {
    "blockId": "p1_b11",
    "text": "The fracture behaviour of (Hf-Ta-Zr-Nb)C high-entropy carbide grains was investigated by microcantilever bending experiments, and fracture related properties (e.g. strength, toughness) were determined using linear beam theory. Microcantilevers were FIB-milled from large grains with {001} and {101} orientations and were subjected to micro-bending experiments. SEM based fractographic analysis of the broken cantilevers revealed that approximately half of them fractured at the fixing position at FIB-induced surface cracks, while the rest of the beams failed at small cracks located at submicron size pores or inclusions. In all cases, fracture occurred on the {001} cleavage plane. The fracture strength of beams fractured at the fixing position was 11.8 ± 0.2 GPa, while the strength of the beams that failed at submicron defects was in the range of 3.8-8.9 GPa. The calculation of stress concentration in the vicinity of pores revealed that local stress field exceeded the value that induced cracking in ‘defect free’ beams.",
  },
  {
    "blockId": "p1_b12",
    "text": "1. Introduction",
  },
  {
    "blockId": "p1_b13",
    "text": "High-entropy ultra-high temperature ceramics are a novel group of materials, which are being developed to broaden the limited set of ultra-high temperature ceramics (UHTCs), comprising about 15 mate- rials [1], and improve their mechanical properties to meet the con- tinuously growing demands of ultra-high temperature applications [2,3]. In general, UTHCs are defined as materials with melting tem- perature above 3000 °C that can withstand extreme environments for applications above 1500 °C in oxidizing and aggressive environments, such as rocket propulsions, hypersonic and re-usable atmospheric re- entry vehicles. UHTCs are usually based on the refractory borides, carbides and nitrides of the group of IV and V transition metals. Due to the nature of their chemical bonds, these materials exhibit high hard- ness (>20 GPa) and strength (>500 MPa) with excellent oxidation and ablation resistance at elevated temperatures [4–6]. Based on the discovery of high-entropy alloys [7,8] and entropy- stabilized oxides [9], bulk high-entropy UHTCs have been successfully synthesized both from metal diborides by Gild el al. [2] and from metal carbides by the present authors [3]. These novel high-entropy ceramics are composed of four or more different transition metal elements of equimolar proportions and boron or carbon atoms, and form hexagonal",
  },
  {
    "blockId": "p1_b14",
    "text": "or cubic solid solution structures, respectively. Experimental and the- oretical studies on these materials suggest that high-entropy ultra-high temperature ceramics could broaden the limited set of UHTCs and their mechanical properties could go beyond those of the base borides [2] and carbides [3,10–13]. Regarding high-entropy carbides, Castle et al. [3] have recently reported that the lattice parameter mismatch of the component monocarbides is a key predictive factor for determining solid solution formation, and hence the (Hf-Ta-Zr-Nb)C composition formed a single phase solid solution more readily than the (Hf-Ta-Zr- Ti)C composition. The high resolution microstructural analysis ex- hibited a random arrangement of transition metal elements in (Hf-Ta- Zr-Nb)C at the atomic scale using energy dispersive X-ray spectroscopy and high angle annular dark field scanning transmission electron mi- croscopy [14]. Micromechanical testing of (Hf-Ta-Zr-Nb)C grains re- vealed higher nano-hardness [3] and significantly enhanced yield and fracture strength during micropillar compression compared to the cor- responding base monocarbides [12]. Additionally, the plasticity of (Hf- Ta-Zr-Nb)C grains was observed during micropillar compression due to {))H} ))H the operation of slip systems [12]. High-temperature creep testing of (Hf-Ta-Zr-Nb)C samples exhibited approximately ten times lower creep rate than that of the corresponding monocarbides con- {)))} ))H trolled by dislocation glide on the slip systems, dislocation",
  },
  {
    "blockId": "p1_b15",
    "text": "⁎ Corresponding author. E-mail address: tcsanadi@saske.sk (T. Csanádi).",
  },
  {
    "blockId": "p1_b16",
    "text": "https://doi.org/10.1016/j.jeurceramsoc.2020.04.023 Received 31 January 2020; Received in revised form 12 April 2020; Accepted 15 April 2020 Available online 20 April 2020 0955-2219/ © 2020 Elsevier Ltd. All rights reserved.",
  },
]
`;

